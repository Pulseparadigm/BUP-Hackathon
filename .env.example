# --- LLM provider (operator-note interpretation) ---
# "openrouter" is the only provider implemented today, but app/llm/factory.py
# reads this to pick the interpreter class -- add a new provider there and
# switch it here without touching main.py.
LLM_PROVIDER=openrouter

OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Any OpenRouter model slug works. Pick one, keep it fast + JSON-reliable.
# Examples: anthropic/claude-haiku-4.5, openai/gpt-4.1-mini,
#           google/gemini-2.5-flash, meta-llama/llama-3.3-70b-instruct
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Optional OpenRouter attribution headers (safe to leave blank).
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=GridWise LLM

# Seconds to wait on the LLM call before falling back (must stay well under
# the judge's 30s hard request timeout).
LLM_TIMEOUT_SECONDS=15

# "degrade" (default): if the LLM/provider call fails outright, treat every
# note as no_op and still return a valid 200 schedule (protects the
# Performance & Reliability score at the cost of that request's
# interpretation score). "error": return HTTP 500 instead.
LLM_FAILURE_MODE=degrade

# --- Optimizer backend ---
# Only "highs" (scipy.optimize.linprog, HiGHS) is implemented, but
# app/optimizer/factory.py reads this the same way -- add another Optimizer
# subclass and switch it here without touching main.py.
SOLVER_BACKEND=highs

# --- Server ---
PORT=8000
